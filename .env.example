# Copy to .env and fill in per client. .env is gitignored.

BASE_URL=https://example.com
API_BASE_URL=https://api.example.com
# API_TOKEN=

# Comma separated. Leave empty for a logged-out-only run.
# AUTH_ROLES=admin,creator,fan

# Per role, prefix with the uppercased role name.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_LOGIN_PATH=/admin/login
# ADMIN_SUCCESS_PATH=/dashboard

# Selector overrides - only needed when defaults miss.
# DEFAULT_USER_SELECTOR=input[name="email"]
# DEFAULT_PASS_SELECTOR=input[name="password"]
# DEFAULT_SUBMIT_SELECTOR=button[type="submit"]

# Point at an alternate targets file for staging vs prod.
# TARGETS_FILE=config/targets.staging.json

# Labels shown on the BVT report header - what install/build this run covers.
# INSTALL_LABEL=Acme - staging
# BUILD_VERSION=v1.4.2
